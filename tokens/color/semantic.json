      "error": { "$value": "{primitive.red.default}" }
    },
    "background": {
      "$type": "color",
      "default": { "$value": "{primitive.mono.white}" },
      "gray": { "$value": "{primitive.gray.lighter}" },
      "blue-grey": { "$value": "{primitive.blue-main.light-gray}" },
      "violet": { "$value": "{primitive.violet.light}" },
      "purple-preg": { "$value": "{primitive.purple.light}" },
      "blue-dark": { "$value": "{primitive.blue-main.light}" },
      "blue-light": { "$value": "{primitive.blue-main.lighter}" },
      "orange-tan": { "$value": "{primitive.orange.light}" },
      "red": { "$value": "{primitive.red.light}" },
      "green": { "$value": "{primitive.green.default-10}" },
      "green-light": { "$value": "{primitive.green.light}" }
    },
    "surface": {
      "$type": "color",
      "blue": { "$value": "{primitive.blue-main.default}" },
