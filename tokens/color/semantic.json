{
  "color": {
    "$description": "Semantic tokens — Figma Variables Colors/Mapped collection",
    "text": {
      "$type": "color",
      "primary": { "$value": "{primitive.mono.black}" },
      "secondary": { "$value": "{primitive.gray.dark}" },
